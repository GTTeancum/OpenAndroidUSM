# Follow Level 6 from its shipped player transform through the authored
# interior, rooftop, bridge, and Venom sequences. Expanded chronologically as
# each room-owned route is verified.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 500000
render_size 640 360

capture level6-gameplay-start

# Spider-Man starts on Room 2's upper floor beside the three symbiotes watched
# by Cinematic 125. Defeat them through ordinary combat so its IfEnemyDead
# chain starts the shipped researcher/stone Cinematic 123 and successor 124.
wait_enemies_active 5000 88 40594 40597
wait_enemies_grounded 5000 88 40594 40597
attack 150000 240 88 40594 40597
assert_health_above 0
wait_cinematic_started 5000 123
capture level6-researcher-cinematic
wait_controls 60000
capture level6-post-researcher

# Cinematic 124 leaves Spider-Man at the top of Object72's curved stair/ramp.
# Follow its authored nav bands down from z=1959 to the z=1332 second floor,
# then clear the four symbiotes watched by Cinematic 41426.
move_to 33950 23850 1828 140 6000
move_to 34025 24400 1667 140 6000
move_to 33750 24875 1497 140 6000
move_to 33250 25250 1332 180 6000
wait_enemies_active 5000 41321 41322 41323 41324
wait_enemies_grounded 5000 41321 41322 41323 41324
attack 180000 240 41321 41322 41323 41324
assert_health_above 0
wait_cinematic_started 5000 41428
capture level6-floor-break-qte

# The default process-local QTE driver presses the abstract shipped action;
# success follows 41464 -> 87 and lands both actors on the ground floor.
wait_controls 30000
assert_near 32717 24090 262 220
assert_gameplay_ui
wait_enemies_active 5000 89
wait_enemies_grounded 5000 89
capture level6-ground-floor
attack 90000 240 89
assert_health_above 0

# Object 89's destroyed watcher reveals the final two interior symbiotes.
# Their watcher closes/removes SpiderWebWall 84 and enables Trigger 40622.
wait_enemies_active 5000 41204 41205
wait_enemies_grounded 10000 41204 41205
attack 120000 240 41204 41205
assert_health_above 0
wait 2000
assert_object_hidden 84
capture level6-interior-clear

# Enter the newly enabled doorway transport and require every native logo
# transition before Cinematic 40621 places Spider-Man in Room 1.
move_until_cinematic 32183 24349 260 40621 10000
wait_transport_state 1000 0
wait_transport_state 1000 1
wait_transport_state 1000 2
wait_transport_state 1500 -1
assert_camera_area 40941
assert_near 27397 7280 1303 200
assert_gameplay_ui
capture level6-room1-arrival

# Room 1's three standard thugs and big thug are already authored active.
# Clear them with ordinary attacks, then use the real obj_collision207
# crossing along WayPoints 3 -> 4 into Room 3.
wait_enemies_active 5000 41304 41305 41306 41307
wait_enemies_grounded 5000 41304 41305 41306 41307
attack 180000 240 41304 41305 41306 41307
