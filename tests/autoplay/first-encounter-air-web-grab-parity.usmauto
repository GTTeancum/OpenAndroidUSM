# Source-authored airborne Circle/B tie-capable target path.  With the nearest
# grounded helper list empty, GetAirWebSpecialState selects state 101 for the
# airborne first-room thug, then state 102's motion-115 grab contact.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 75000
start_time_ms 53033
render_size 1280 720

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397
set_enemy_ai 394 0
set_enemy_ai 395 0
set_enemy_ai 397 0
set_enemy_physics 394 1
damage_enemy 395 100000
damage_enemy 397 100000
teleport 13399 -6360 7 0 -1 0

punch
jump_release_attack_when_ready 1000
move_until_state 1000 0 0 97
wait 350
assert_enemy_health_near 394 405 0.01
move_until_state 1500 0 0 0

jump
wait 80
web_on
move_until_state 500 0 0 101
assert_player_state 101
assert_player_web_line 1 1 394
assert_enemy_health_near 394 405 0.01

# State 101 does not damage.  Its 333 ms primary hands off to state 102, which
# sends the retained zero-damage motion-115 contact while the line stays owned.
move_until_state 1000 0 0 102
assert_player_state 102
assert_player_web_line 1 1 394
assert_enemy_health_near 394 405 0.01
move_until_state 1000 0 0 14
assert_player_web_line 0 0 -1
assert_enemy_health_near 394 405 0.01
assert_health_above 0
finish
