# Enter room two through authored trigger 973. Cinematic 974 performs the
# rooftop spider-sense exchange, kills actor 400, reveals the three staged
# enemies, and activates their physics before combat begins.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 120000
start_time_ms 53033
render_size 1280 720

wait_gameplay 60000
teleport 8800 -5860 7 -1 0 0
move_until_cinematic 8430 -5710 7 974 5000
# Cinematic 974 opens the indefinite spider-sense tutorial at 2300 ms. Let
# that authored command arrive, then acknowledge it before waiting on the
# three revealed enemies' landing states.
wait 2600
wait_controls 12000
# The authored reveal commands must make all three actors visible and AI/
# physics-active before their rooftop fall can settle on the Room 2 street.
wait_enemies_active 5000 398 399 401
wait_enemies_grounded 10000 398 399 401
assert_enemy_health_near 398 500 0.01
assert_enemy_health_near 399 500 0.01
assert_enemy_health_near 401 500 0.01
capture second-encounter-landed
attack 45000 190 398 399 401
# Cinematic 1140 is the native destroyed-object watcher. The final death
# closes/removes web wall 1116 and saves authored checkpoint 30027.
wait_controls 10000
assert_last_checkpoint 30027
capture second-encounter-cleared
assert_health_above 0
finish
