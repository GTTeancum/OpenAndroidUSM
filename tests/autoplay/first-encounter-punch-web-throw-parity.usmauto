# Source-authored punch -> air-bind -> backward throw -> 540 throw branch.
# Room-1 thugs expose CBehaviorTiedUp, so state 94 remains valid rather than
# falling back to state 95's kick for an untieable target.
fixed_step_ms 10
sample_interval_ms 10
capture_interval_ms 0
max_time_ms 75000
start_time_ms 53033
render_size 1280 720

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397
set_enemy_ai 394 0
set_enemy_ai 395 0
set_enemy_ai 397 0
set_enemy_physics 394 1
teleport 13399 -6360 7 0 -1 0

punch
web_attack_when_ready 1000
move_until_state 1000 0 0 92
move_until_state 1000 0 0 93
assert_enemy_health_near 394 430 0.01

web_attack_when_ready 1000
move_until_state 1000 0 0 94
assert_player_state 94
assert_enemy_health_near 394 430 0.01

# Buffer B/Circle during state 94. Its own motion-0x82 hit still occurs at
# authored frame 21 before the queued state-66 continuation is consumed.
web_attack_when_ready 1000
assert_enemy_health_near 394 430 0.01
wait 560
assert_enemy_health_near 394 280 0.01
move_until_state 1000 0 0 66
assert_enemy_health_near 394 280 0.01
move_until_state 1000 0 0 67
assert_enemy_health_near 394 280 0.01
wait 650
assert_enemy_health_near 394 60 0.01
assert_health_above 0
finish
