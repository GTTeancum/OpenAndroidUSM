# Normal-flow enemy-offense gate for all attack variants authored by the
# first three thugs. No damage or animation is injected: each hit is emitted
# by the production AI, animation key, attack volume, and player hurt path.
fixed_step_ms 25
sample_interval_ms 25
capture_interval_ms 0
max_time_ms 85000
start_time_ms 53033
render_size 640 360

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397

# Knife attack 6 has two live contacts at 45 and 75 percent. At 25 damage
# apiece, one complete authored attack must take 1000 -> 950 health.
set_enemy_ai 395 0
set_enemy_ai 397 0
set_enemy_ai 394 1 1
teleport 13456 -6311 7 -1 0 0
wait_enemy_melee_attack 10000 394
wait 800
assert_player_state 44
wait 500
assert_health_above 949
assert_health_below 951
assert_audio_played SFX_THUG_SWOOSH

# Bat state 11 resolves its two equal +0x38 attack-distance values with the
# shipped Irrlicht RNG. At this point in the covered encounter sequence,
# this normal-flow command cadence observes standing attack 7 twice
# (35 points at 47 percent), followed by jumping attack 11 (50 points at
# 70 percent). Every selected branch below is pinned together with its
# resulting damage rather than inherited from the removed alternator.
set_enemy_ai 394 0
set_enemy_ai 395 1 1
teleport 13229 -6441 7 -1 0 0
wait_enemy_melee_attack 10000 395
wait_enemy_animation 1000 395 idle_at1_idle
wait 925
assert_player_state 45
assert_health_above 914
assert_health_below 916
wait_enemy_melee_inactive 10000 395
teleport 13229 -6441 7 -1 0 0
wait_enemy_melee_attack 10000 395
wait_enemy_animation 1000 395 idle_at1_idle
wait 925
assert_player_state 45
assert_health_above 879
assert_health_below 881
wait_enemy_melee_inactive 10000 395
teleport 13229 -6441 7 -1 0 0
wait_enemy_melee_attack 10000 395
wait_enemy_animation 1000 395 idle_jump_at3_idle
wait 1000
assert_player_state 45
assert_health_above 829
assert_health_below 831
assert_audio_played SFX_THUG_SWOOSH
finish
