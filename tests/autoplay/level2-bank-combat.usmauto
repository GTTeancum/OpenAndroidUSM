# Level 2 starts in the bank lobby with four molotov thugs on the ground floor
# and four melee/hammer/molotov enemies on the upper floor. Exercise both
# authored death-watcher chains. The lower floor uses ordinary combat; the
# upper cohort uses the process-local damage hook so accumulated lower-floor
# damage cannot turn this script-chain probe into a player-survival test.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 180000
start_time_ms 0
render_size 1280 720

wait_gameplay 1000
wait_enemies_active 5000 502 503 504 10345
capture level2-bank-lower-before
attack 70000 150 502 503 504 10345
wait_controls 20000
capture level2-bank-lower-after
teleport -20350 10000 962 0 1 0
wait_enemies_active 5000 640 641 642 1141
wait 500
capture level2-bank-upper-before
damage_enemy 640 100000
damage_enemy 641 100000
damage_enemy 642 100000
damage_enemy 1141 100000
wait_controls 20000
capture level2-bank-upper-after
assert_health_above 0
finish
