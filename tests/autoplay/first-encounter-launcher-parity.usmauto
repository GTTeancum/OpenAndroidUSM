# First-fight combat gate: prove the shipped uppercut force launches the live
# enemy PhysicsEntity, advances through the authored airborne hurt graph, and
# leaves it eligible for Spider-Man's target-special aerial follow-up.
fixed_step_ms 10
sample_interval_ms 10
capture_interval_ms 0
max_time_ms 75000
start_time_ms 53033
render_size 1280 720

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397

# Isolate the first knife thug while retaining its live PhysicsEntity.
set_enemy_ai 395 0
set_enemy_ai 397 0
teleport 13356 -6411 7 0 1 0

# X followed by A is the authored state-74 -> state-76 launcher branch.
punch
jump_attack_when_ready 1000
move_until_state 500 0 0 76
wait_enemy_animation 1000 394 idle_to_air
assert_player_effect 3 1
wait_enemy_animation 1500 394 air_to_fall
assert_enemy_health_below 394 500

# State 76 exits to jump-fall. X must then choose the airborne-target special
# (state 86), not the untargeted aerial punch or a rejected ground attack.
move_until_state 1500 0 0 14
punch
move_until_state 500 0 0 86
assert_player_effect 26 1
wait 200
assert_player_effect 16 1
assert_enemy_health_below 394 465
assert_health_above 0
finish
