# Chronological coverage for the first encounter where Ultimate is really
# unlocked. The shipped 40039 activation volume enables Room 5 and cinematic
# 969 supplies profile skill bit 0 through CCinematicThread::OnUnlock
# (0x0037240c). This scenario deliberately does not use unlock_skill.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 150000
start_time_ms 53033
render_size 640 360

wait_gameplay 1000
cross_trigger 40039 40040 5000
wait_enemies_active 5000 10339 10340 1251
teleport 2830 2950 117 1 0 0
wait_cinematic_started 5000 969
wait_controls 10000

# Keep the authored Room 5 trio centered inside state 109's radial hit while
# preventing their choices from interrupting the state chain. Their shipped
# scene records all begin at 500 health.
set_enemy_ai 10339 0
set_enemy_ai 10340 0
set_enemy_ai 1251 0
teleport 2830 2950 117 1 0 0
assert_enemy_health_near 10339 500 0.01
assert_enemy_health_near 10340 500 0.01
assert_enemy_health_near 1251 500 0.01
assert_web_power_near 1000 0.01

# Production Ultimate input must now be admitted by cinematic 969's real
# unlock bit. Pin the native red-suit 107 -> 108 -> 109 presentation chain.
super_attack
assert_player_state 107
assert_web_power_near 0 0.01
assert_slow_motion 3
assert_player_effect 24 1
move_until_state 5000 0 0 108
assert_player_effect 22 4
move_until_state 5000 0 0 109
assert_player_effect 25 1
wait 1200
# State 108's 200 cm wheel catches only knife thug 10339 for 25 damage at
# this shipped spacing. State 109 then gives all three the authored 200-damage
# radial hit, leaving the exact native ledger below.
assert_enemy_health_near 10339 275 0.01
assert_enemy_health_near 10340 300 0.01
assert_enemy_health_near 1251 300 0.01
assert_audio_played SFX_SUPER_WEB_FINAL_ATTACK
move_until_state 5000 0 0 0
assert_slow_motion 1
assert_health_above 0
finish
