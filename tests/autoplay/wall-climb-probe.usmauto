# Isolate the first regular climbable surface in Room 8. The target is beyond
# wall04 so move_until_wall proves that the native 0x20 surface was acquired;
# raw wall-relative forward input then climbs for one second.
fixed_step_ms 25
sample_interval_ms 25
capture_interval_ms 250
max_time_ms 57000
start_time_ms 53033
render_size 640 360

wait_gameplay 5000
teleport 4700 4000 145 1 0 0
move_until_wall 5000 4000 145 2000
move_input 1000 0 1
capture wall-climb-end
wait 250
finish
