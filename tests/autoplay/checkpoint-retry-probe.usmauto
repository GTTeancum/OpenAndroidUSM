# Activates shipped OBB CheckPoint 755, exhausts health through authored
# TriggerRestore 539, then selects GS_Confirmation's Yes entry. This proves
# CLevel::RestartAtLastCheckPoint / Application::LoadCheckPoint state and
# placement without sending host input to the game window.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 75000
start_time_ms 53033
render_size 1280 720

wait_gameplay 1000
teleport 9033.422 -5652.256 366.227 1 0 0
wait 100
assert_last_checkpoint 755

teleport 4744.765 -6427.654 -500 1 0 0
wait_controls 5000
teleport 4744.765 -6427.654 -500 1 0 0
wait_controls 5000
teleport 4744.765 -6427.654 -500 1 0 0
wait_controls 5000
teleport 4744.765 -6427.654 -500 1 0 0
wait_controls 5000
teleport 4744.765 -6427.654 -500 1 0 0
wait_death_confirmation 5000
assert_health_below 1
menu_select
wait_controls 5000
assert_death_screen_inactive
assert_death_confirmation_inactive
assert_last_checkpoint 755
assert_camera_area 10005
assert_near 9033.422 -5652.256 366.227 5
assert_health_above 999
assert_audio_stopped M_LOSE
finish
