# Holding B/Circle through the native state-58 web shot must consume its
# predicate-103 transition and continue into the target-retaining bind/drag
# chain. A fresh second press is not required.
fixed_step_ms 10
sample_interval_ms 10
capture_interval_ms 0
max_time_ms 75000
start_time_ms 53033
render_size 1280 720

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397
set_enemy_ai 394 0
set_enemy_ai 395 0
set_enemy_ai 397 0
set_enemy_physics 394 1
teleport 13399 -6360 7 0 -1 0

web_on
move_until_state 500 0 0 58
assert_player_state 58
web_held_attack_when_ready 1000
move_until_state 1000 0 0 60
assert_player_state 60
move_until_state 2500 0 0 62
assert_player_state 62
wait 100
# Native state 62 copies state 60's zero damage on entry. The pellet is the
# only damaging contact in this no-input branch.
assert_enemy_health_near 394 480 0.01
assert_health_above 0
finish
