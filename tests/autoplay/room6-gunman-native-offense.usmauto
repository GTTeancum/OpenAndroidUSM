# Focused Room 6 production-AI gate for the first type-3 gun thug. The
# runtime shot must come through the shipped range behavior, authored fire
# key, native RNG hand choice, gun-line projectile, damage, and sound path.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 70000
start_time_ms 53033
render_size 640 360

wait_gameplay 1000
set_enemy_ai 481 0
set_enemy_ai 482 0
set_enemy_ai 483 0
set_enemy_ai 1139 0
teleport 12173 9269 3479 1 0 0
set_enemy_ai 10344 1
wait_enemy_projectile 5000 10344
assert_audio_played SFX_THUG_GUN_SHOOT
wait 1000
assert_health_below 1000
assert_health_above 0
finish
