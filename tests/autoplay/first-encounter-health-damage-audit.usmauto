# Source-backed damage ledger for the three authored Level 1 opening thugs.
# Enemy decisions are frozen only after the normal encounter trigger activates;
# player input, targeting, state transitions, hit frames, and damage all use the
# production runtime path.
fixed_step_ms 25
sample_interval_ms 25
capture_interval_ms 0
max_time_ms 75000
start_time_ms 53033
render_size 1280 720

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397
set_enemy_ai 394 0
set_enemy_ai 395 0
set_enemy_ai 397 0

# All three values come directly from the shipped Room1 scene attributes.
assert_enemy_health_near 394 500 0.01
assert_enemy_health_near 395 500 0.01
assert_enemy_health_near 397 500 0.01

# Default ground chain. Native CheckAttackTarget divides each multi-hit
# state's total damage across its authored contact list. Collision remains
# per contact. Physics::testPieCollision transforms the enemy cylinder's
# authored local {0,0,radius} center, so both state-78 pulses overlap this
# grounded thug and the six-button chain lands
#   35 + 35 + 55 + 85 + 85 + 80 = 375.
teleport 13399 -6360 7 0 -1 0
punch
assert_player_state 74
punch_when_ready 1000
move_until_state 1000 0 0 75
assert_player_state 75
# The transition window opens only after state 74's rounded 175 ms impact.
assert_enemy_health_near 394 465 0.01

punch_when_ready 1000
move_until_state 1000 0 0 79
assert_player_state 79
assert_enemy_health_near 394 430 0.01

punch_when_ready 1000
move_until_state 1000 0 0 90
assert_player_state 90
assert_enemy_health_near 394 375 0.01

punch_when_ready 1000
move_until_state 1000 0 0 91
assert_player_state 91
# State 90 is 85 total, delivered as four 21.25 contacts.
assert_enemy_health_near 394 290 0.01

# State 91 is another 85 total. State 78 authors two 40-damage contacts and
# both intersect the correctly centered target cylinder.
punch_when_ready 1000
assert_enemy_health_near 394 205 0.01
move_until_state 1000 0 0 78
assert_player_state 78
wait 500
assert_enemy_health_near 394 125 0.01
move_until_state 2000 0 0 0

# The next chain removes the remaining 125 in its first three contacts.
set_enemy_ai 394 1
wait_enemies_grounded 3000 394
set_enemy_ai 394 0
teleport 13399 -6360 7 0 -1 0
punch
wait 200
assert_enemy_health_near 394 90 0.01
punch_when_ready 1000
move_until_state 1000 0 0 75
wait 150
assert_enemy_health_near 394 55 0.01
punch_when_ready 1000
move_until_state 1000 0 0 79
wait 200
assert_enemy_health_near 394 0 0.01
assert_health_above 0
finish
