# Source-level normal-flow coverage for the first live knife attack and the
# Player::DoNormalSenseAction counter it registers. Only the two bystanders
# are frozen; thug 394 must naturally engage, warn, animate, and attack.
fixed_step_ms 50
sample_interval_ms 50
capture_interval_ms 0
max_time_ms 80000
start_time_ms 53033
render_size 640 360

wait_gameplay 60000
teleport 14172 -7978 7 -0.416 -0.909 0
move_until_cinematic 14067 -8205 7 71 10000
wait_enemies_active 5000 394 395 397
set_enemy_ai 395 0
set_enemy_ai 397 0

# Stand inside the native 200 cm counter threshold with the knife thug in
# front. The harness waits for its real melee registration instead of
# injecting an attack or damage event.
teleport 13399 -6650 7 0 1 0
wait_enemy_melee_attack 10000 394
unlock_skill 1
wait 50
assert_spider_sense_cue 1
spider_sense
assert_player_state 38
assert_spider_sense_cue 0
assert_slow_motion 3
assert_web_power_near 800 0.01

# UpdateSpiderSense pops this warning from CTargetHelper before entering the
# counter. A second LB edge during the same knife animation must not consume
# the already-handled attack and replace state 38 with another sense state.
spider_sense
assert_player_state 38
assert_web_power_near 800 0.01

# State 38's serialized contact is frame 8 (400 game ms). EnemyAttackInfo
# supplies 3x slow motion until CheckAttackTarget resets it at that frame.
wait 550
assert_enemy_health_near 394 200 0.01
assert_player_effect 7 1
assert_slow_motion 1
assert_health_above 999
finish
