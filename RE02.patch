+    input=pad.translate(qte,true,false,true,false,0,1); // wrong direction
+    qte.update({1100,50},input); CHECK(qte.active());
+    input=pad.translate(qte,true,false,true,false,0,-0.5F);
+    qte.update({1150,50},input); CHECK(qte.active());
+    input=pad.translate(qte,true,false,false,true,0,-0.5F);
+    CHECK(input.dragReleased);
+    qte.update({1200,50},input); CHECK(qte.state()==QteState::FailureDisplay);
+    finishFeedback(qte,1200);(void)qte.consumeCinematicRequest();
+    CHECK(qte.applyCommand(startCommand(6),{2000,0}));
+    input=pad.translate(qte,true,false,true,false,0,-1); // held across activation is not a fresh touch
+    CHECK(!input.dragPosition);
+    qte.update({2050,50},input); CHECK(qte.active());
+    input=pad.translate(qte,true,true,true,false,0,0);
+    qte.update({2100,50},input);
+    input=pad.translate(qte,true,false,true,false,0,-1);
+    qte.update({2150,50},input); CHECK(qte.state()==QteState::SuccessDisplay);
+    finishFeedback(qte,2150);(void)qte.consumeCinematicRequest();
+    CHECK(qte.applyCommand(startCommand(6),{3000,0}));
+    (void)pad.translate(qte,true,true,true,false,0,0);
+    input=pad.translate(qte,false,false,false,true,0,-1);
+    CHECK(!input.dragPosition && !input.dragReleased && !input.actionPressed);
+    qte.update({3050,50},input); CHECK(qte.active());
+    input=pad.translate(qte,true,false,true,false,0,-1);
+    CHECK(!input.dragPosition); // reconnect does not inherit a held gesture
+    qte.update({3100,50},input); CHECK(qte.active());
+    // Diagnostic autoplay also sends positions; it cannot force success by A.
+    usm::diagnostics::AutoplayHarness autoplay;
+    for(int i=0;i<14;++i) {
+        input=autoplay.quickTimeInput(qte,true);
+        CHECK(input.dragPosition==qte.gesturePath().samples()[i]);
+        qte.update({static_cast<std::uint32_t>(3150+i*50),50},input);
+        CHECK((i==13)==(qte.state()==QteState::SuccessDisplay));
+    }
+}
