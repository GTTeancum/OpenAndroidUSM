+#pragma once
+
+#include "game/QuickTimeEventRuntime.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace usm::platform {
+// PC input adaptation, NOT a claimed Xperia hardware mapping. A is a virtual
+// touch hold; left-stick displacement supplies a position on the original
+// screen. The recovered manager alone judges the gesture and its release.
+// There is no velocity, arbitrary success percentage, or force-success call.
+class QteGamepadAdapter final {
+public:
+    [[nodiscard]] game::QteInput translate(
+        const game::QuickTimeEventRuntime& runtime, bool connected,
+        bool pressed, bool held, bool released, float stickX, float stickY) noexcept {
+        game::QteInput input{connected && pressed, std::nullopt, false};
+        if (generation_ != runtime.generation()) {
+            generation_ = runtime.generation(); dragging_ = false;
+        }
+        if (!connected || runtime.state() != game::QteState::Drag) {
+            dragging_ = false; return input;
+        }
+        if (pressed) { dragging_ = true; }
+        if (!dragging_ || (!held && !released)) { return input; }
+        const auto& path = runtime.gesturePath();
+        const auto start = path.start(), end = path.end();
+        const float extent = static_cast<float>(std::abs(path.horizontal()
+            ? static_cast<int>(end.x) - start.x : static_cast<int>(end.y) - start.y));
+        const auto axis = [](float v) { return std::isfinite(v) ? std::clamp(v, -1.0F, 1.0F) : 0.0F; };
+        // Same scale on both axes; XInput up is positive, screen down positive.
+        // Truncate toward zero, as the native screen-coordinate conversions do.
+        const auto coordinate = [](float v) {
+            return static_cast<std::int16_t>(std::clamp(v, -32768.0F, 32767.0F));
+        };
+        input.dragPosition = game::QtePoint{
+            coordinate(static_cast<float>(start.x) + axis(stickX) * extent),
+            coordinate(static_cast<float>(start.y) - axis(stickY) * extent)};
+        input.dragReleased = released;
+        if (released) { dragging_ = false; }
+        return input;
+    }
+    [[nodiscard]] bool dragging() const noexcept { return dragging_; }
+private:
+    std::uint64_t generation_{};
+    bool dragging_{};
+};
+} // namespace usm::platform
